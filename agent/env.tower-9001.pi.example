# /opt/scheduler/.env  --  jantaPi, tower 9001
#
#   cp env.tower-9001.pi.example /opt/scheduler/.env
#   chmod 600 /opt/scheduler/.env        # holds two API credentials
#
# No inline comments after a value: both this loader and systemd's
# EnvironmentFile= take everything after the "=" literally, so
# `NB_AUTO_FLASH=0   # off` would set it to the string "0   # off".

# --- this machine -----------------------------------------------------------
NB_DEVICE_ID=9001
NB_SCHEDULER_DIR=/opt/scheduler
NB_STATE_DIR=/opt/scheduler/nightly

# The stable by-id path, NOT /dev/ttyACM0. It is derived from the chip's MAC,
# so it survives resets, reboots and being moved to another USB port - which
# /dev/ttyACM0 does not.
AXUM_PORT=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_90:E5:B1:D8:4F:48-if00

# Put the logs on a USB SSD if you have one. The supervisor flushes after every
# line so a crash can't lose the lines explaining the crash, and that is the
# worst possible write pattern for SD flash on a box running 24/7.
AXUM_LOG_DIR=/opt/scheduler/logs

# Point this at the shared mount once the desktop is exporting it, so both
# towers' reports land in one place for the web app.
AXUM_REPORTS_DIR=/opt/scheduler/public/reports

AXUM_REPORTER=/opt/scheduler/report_and_retain.py
AXUM_PROMPT_PATH=/opt/scheduler/axum_nightly_analysis_prompt.md

# --- github -----------------------------------------------------------------
NB_GITHUB_REPO=JPI-US/nightly-built
# Fine-grained PAT, Actions: Read on nightly-built. A deploy key cannot be used
# here - artifact downloads go through the REST API. Rotate before it expires
# or the agent just starts logging download failures.
NB_GITHUB_TOKEN=
NB_POLL_SECS=180

# --- flashing ---------------------------------------------------------------
NB_CHIP=esp32s3
# 0 while you're still watching it. Set to 1 once you trust the flash path and
# every green build should go onto the tower unattended.
NB_AUTO_FLASH=0
# 1 erases NVS, so the tower re-homes from scratch on the next boot and that
# shows up in the report. Set 0 to keep heading/encoder state across flashes.
NB_ERASE_FLASH=1
NB_CONTROL_PORT=8787

# --- capture supervisor -----------------------------------------------------
NB_AUTO_RESET_AFTER=25
NB_AUTO_RESET_MAX=2
NB_ROLLOVER_HOUR=23

# --- report generation ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
