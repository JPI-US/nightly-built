# /opt/scheduler/.env  --  second Raspberry Pi, tower 9000
#
# provision-pi.sh writes this for you from the 9001 template, substituting
# NB_DEVICE_ID and the detected serial path. This copy is the reference.
#
# No inline comments after a value: both this loader and systemd's
# EnvironmentFile= take everything after the "=" literally, so
# `NB_AUTO_FLASH=0   # off` would set it to the string "0   # off".

# --- this machine -----------------------------------------------------------
# Scopes every filename this repo writes, so both Pis can publish into one
# reports folder without overwriting each other:
#   build-9000-<date>.json, capture-status-9000.json, flash-9000-<date>.json
NB_DEVICE_ID=9000
NB_SCHEDULER_DIR=/opt/scheduler
NB_STATE_DIR=/opt/scheduler/nightly

# The stable by-id path for THIS tower's board - it embeds that chip's MAC, so
# it differs from the other Pi's. Never /dev/ttyACM0, which is assigned in
# enumeration order and can move.
AXUM_PORT=/dev/serial/by-id/REPLACE_WITH_THIS_BOARDS_PATH

# The supervisor flushes after every line so a crash can't lose the lines
# explaining the crash - the worst possible write pattern for SD flash on a box
# running 24/7. Point this at a USB SSD if you have one.
AXUM_LOG_DIR=/opt/scheduler/logs

# Point at the shared mount once one exists, so both towers' reports land in
# one place for the web app.
AXUM_REPORTS_DIR=/opt/scheduler/public/reports

AXUM_REPORTER=/opt/scheduler/report_and_retain.py
AXUM_PROMPT_PATH=/opt/scheduler/axum_nightly_analysis_prompt.md

# --- github -----------------------------------------------------------------
NB_GITHUB_REPO=JPI-US/nightly-built
# Fine-grained PAT, Actions: Read on nightly-built. A deploy key cannot be used
# here - artifact downloads go through the REST API. Can be the same token the
# other Pi uses, or a separate one if you'd rather revoke them independently.
NB_GITHUB_TOKEN=
NB_POLL_SECS=180

# --- flashing ---------------------------------------------------------------
NB_CHIP=esp32s3
# 0 while you're still watching it. Set to 1 once you trust the flash path and
# every green build should go onto the tower unattended.
NB_AUTO_FLASH=0
# 1 erases NVS, so the tower re-homes from scratch on the next boot and that
# shows up in the report. Set 0 to keep heading/encoder state across flashes.
NB_ERASE_FLASH=1
# Each Pi runs its own supervisor on its own loopback, so both use 8787 - they
# never talk to each other.
NB_CONTROL_PORT=8787

# --- capture supervisor -----------------------------------------------------
NB_AUTO_RESET_AFTER=25
NB_AUTO_RESET_MAX=2
NB_ROLLOVER_HOUR=23

# --- report generation ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
