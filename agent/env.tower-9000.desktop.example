# D:\scheduler\.env  --  office desktop, tower 9000
#
# APPEND these to the existing D:\scheduler\.env rather than replacing it -
# process_log.py and report_and_retain.py read the same file, and the settings
# already in there (AXUM_PORT, ANTHROPIC_API_KEY) still apply.
#
# No inline comments after a value; the loader takes everything after "="
# literally.

# --- this machine -----------------------------------------------------------
# Scopes every filename this repo writes, so the desktop and the Pi can publish
# into one reports folder without overwriting each other:
#   build-9000-<date>.json, capture-status-9000.json, flash-9000-<date>.json
NB_DEVICE_ID=9000
NB_SCHEDULER_DIR=D:\scheduler
NB_STATE_DIR=D:\scheduler\nightly

# Already set in your existing .env - shown so the whole picture is in one place:
# AXUM_PORT=COM11
# AXUM_LOG_DIR=D:\scheduler\logs
# AXUM_REPORTS_DIR=D:\scheduler\public\reports
# ANTHROPIC_API_KEY=sk-ant-...

# --- github -----------------------------------------------------------------
NB_GITHUB_REPO=JPI-US/nightly-built
# Fine-grained PAT, Actions: Read on nightly-built. Can be the same token the
# Pi uses, or a separate one if you'd rather revoke them independently.
NB_GITHUB_TOKEN=
NB_POLL_SECS=180

# --- flashing ---------------------------------------------------------------
NB_CHIP=esp32s3
NB_AUTO_FLASH=0
NB_ERASE_FLASH=1
# Each machine runs its own supervisor on its own loopback, so both can use
# 8787 - they never talk to each other.
NB_CONTROL_PORT=8787

# --- capture supervisor -----------------------------------------------------
NB_AUTO_RESET_AFTER=25
NB_AUTO_RESET_MAX=2
NB_ROLLOVER_HOUR=23
