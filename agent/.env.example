# Append these to D:\scheduler\.env  (shared with process_log.py / capture_daemon.py)

# --- existing scheduler settings, shown for reference -----------------------
# AXUM_PORT=COM11
# AXUM_LOG_DIR=D:\scheduler\logs
# AXUM_REPORTS_DIR=D:\scheduler\public\reports
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- nightly build ---------------------------------------------------------
NB_GITHUB_REPO=JPI-US/nightly-built
NB_GITHUB_TOKEN=                 # fine-grained PAT, Actions: read on the repo above
NB_WORKFLOW_FILE=nightly-build.yml
NB_POLL_SECS=180

# --- flashing --------------------------------------------------------------
NB_CHIP=esp32s3
NB_AUTO_FLASH=0                  # 1 = flash every green build automatically
NB_ERASE_FLASH=1                 # 0 = keep NVS (heading/encoder snapshots) across flashes
NB_CONTROL_PORT=8787

# --- capture supervisor ----------------------------------------------------
NB_AUTO_RESET_AFTER=25           # seconds of post-attach silence before a self-reset
NB_AUTO_RESET_MAX=2              # per attach; the budget resets once a line arrives
NB_ROLLOVER_HOUR=23
NB_STATE_DIR=D:\scheduler\nightly
